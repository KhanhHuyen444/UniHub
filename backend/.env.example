# HTTP server cục bộ; chỉ backend đọc biến này.
PORT=3001
# URL minh họa cho ứng dụng (sau này); không phải tài khoản đã tạo.
# Runtime không dùng tài khoản migration. Mọi session phải đặt time_zone UTC.
DATABASE_URL="mysql://unihub_app:example_password@127.0.0.1:3306/unihub_dev"
# Health HTTP vẫn chỉ cần PORT; chưa có Google credentials hoặc JWT secret.
