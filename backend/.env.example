# HTTP server cục bộ; chỉ backend đọc biến này.
PORT=3001
# URL minh họa cho runtime, không phải tài khoản hoặc database đã được tạo.
# Runtime chỉ đọc DATABASE_URL; không dùng MIGRATION_DATABASE_URL làm fallback.
# URL không hỗ trợ query/hash. URL-encode ký tự đặc biệt trong username/password.
DATABASE_URL="mysql://unihub_app:example_password@localhost:3306/unihub_dev"
# GET /api/health không cần MySQL; GET /api/ready cần DATABASE_URL và MySQL hoạt động.
# Chỉ dùng cho API được bảo vệ; health/ready và API công khai không đọc các giá trị này.
# Thay bằng secret ngẫu nhiên tối thiểu 32 byte trước khi bật middleware.
JWT_SIGNING_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"
JWT_ISSUER="https://api.unihub.local"
JWT_AUDIENCE="unihub-api"
# Client ID công khai của Google Web OAuth; thay bằng client ID nhóm đã tạo.
GOOGLE_CLIENT_ID="replace-with-google-web-client-id.apps.googleusercontent.com"
# Origin chính xác, phân tách bằng dấu phẩy nếu có nhiều môi trường.
AUTH_ALLOWED_ORIGINS="http://127.0.0.1:5173"
# Cookie refresh dùng cố định theo contract: HttpOnly; Secure; SameSite=Strict;
# Path=/api/auth; Max-Age=604800. Không cấu hình cookie secret riêng.
