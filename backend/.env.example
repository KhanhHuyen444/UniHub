# Local UniHub demo environment. Copy to backend/.env and replace placeholders.
# Never commit backend/.env, secrets or real database credentials.
PORT=3001
# MySQL runtime uses its own restricted user; DO NOT use MySQL root/migration user.
# The canonical handoff database is unihub_demo (never unihub_dev).
# Encode reserved username/password characters for URL; no query/hash supported.
DATABASE_URL="mysql://unihub_demo_app:REPLACE_RUNTIME_PASSWORD@127.0.0.1:3306/unihub_demo"
# Health endpoint needs only HTTP; /api/ready checks MySQL connectivity.
# Replace with a fresh randomly generated secret of >= 32 bytes.
JWT_SIGNING_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"
JWT_ISSUER="http://127.0.0.1:3001"
JWT_AUDIENCE="unihub-demo-api"
# Google Web Client ID; register the actual frontend origin with Google.
GOOGLE_CLIENT_ID="replace-with-google-web-client-id.apps.googleusercontent.com"
AUTH_ALLOWED_ORIGINS="http://127.0.0.1:5173"
# Refresh cookie attributes are fixed by auth implementation; don't weaken security here.
