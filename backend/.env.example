# HTTP server cục bộ; chỉ backend đọc biến này.
PORT=3001
# URL minh họa, không phải tài khoản hoặc database đã được tạo.
# Các lệnh format/validate/generate không cần MySQL hoặc URL này.
# prisma.config.ts không tự nạp .env thật; xem docs/database-schema.md.
DATABASE_URL="mysql://example_user:example_password@127.0.0.1:3306/unihub_example"
# Health HTTP vẫn chỉ cần PORT; chưa có Google credentials hoặc JWT secret.
