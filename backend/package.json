{
  "name": "@unihub/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run prisma:generate",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "npm run build && node --test",
    "prisma:format": "prisma format --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --config prisma.config.ts",
    "db:migrate:status": "node --env-file-if-exists=.env.migration ../node_modules/prisma/build/index.js migrate status --config prisma.config.ts",
    "db:migrate:deploy": "node --env-file-if-exists=.env.migration ../node_modules/prisma/build/index.js migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0",
    "google-auth-library": "11.3.1",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
