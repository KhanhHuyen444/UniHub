{
  "name": "@unihub/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "npm run build && node --test test/http.test.mjs",
    "prisma:format": "prisma format --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --config prisma.config.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
