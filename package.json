{
  "name": "unihub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev:frontend": "npm run dev --workspace @unihub/frontend",
    "dev:backend": "npm run dev --workspace @unihub/backend",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace @unihub/backend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
